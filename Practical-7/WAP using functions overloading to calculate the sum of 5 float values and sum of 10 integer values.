#include <iostream>
using namespace std;

class Calc {
public:
    void sum(float a[5]) {
        int i;
        float s = 0;
        for (i = 0; i < 5; i++)
            s = s + a[i];
        cout << "Sum: " << s << endl;
    }
    void sum(int a[10]) {
        int i, s = 0;
        for (i = 0; i < 10; i++)
            s = s + a[i];
        cout << "Sum: " << s << endl;
    }
};

int main() {
    Calc c1;
    int a[10] = {1, 5, 2, 6, 8, 6, 5, 22, 8, 54};
    float b[5] = {2.3, 5.1, 8.9, 5.5, 4.1};
    c1.sum(b);
    c1.sum(a);
    return 0;
}
