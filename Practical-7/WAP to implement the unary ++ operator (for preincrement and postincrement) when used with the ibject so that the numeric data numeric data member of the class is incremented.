#include <iostream>
using namespace std;

class Number {
private:
    int a;
public:
    void accept() {
        cout << "Enter a: ";
        cin >> a;
    }
    void operator++() {
        ++a;
    }
    void display() {
        cout << "Value: " << a << endl;
    }
};

int main() {
    Number n1;
    n1.accept();
    ++n1;
    n1.display();
    return 0;
}
