#include <iostream>
#include <string>
using namespace std;

class Vehicle {
protected:
    string brand;
    string model;
public:
    Vehicle() {
        brand = "BMW";
        model = "m3";
    }
};

class Car : public Vehicle {
protected:
    string attribute;
public:
    Car() {
        attribute = "Sedan";
    }
};

class ElectricCar : public Car {
private:
    string battery;
public:
    ElectricCar() {
        battery = "66kwh";
    }
    void display() {
        cout << "Brand: " << brand << endl;
        cout << "Model: " << model << endl;
        cout << "Attribute: " << attribute << endl;
        cout << "Battery: " << battery << endl;
    }
};

int main() {
    ElectricCar e1;
    e1.display();
    return 0;
}
