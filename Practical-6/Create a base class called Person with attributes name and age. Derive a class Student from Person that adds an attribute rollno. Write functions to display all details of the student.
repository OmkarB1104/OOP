#include <iostream>
#include <string>
using namespace std;

class Person {
protected:
    string name;
    int age;
public:
    Person() {
        name = "Omkar";
        age = 17;
    }
};

class Student : public Person {
private:
    int rollno;
public:
    Student() {
        rollno = 28;
    }
    void display() {
        cout << "Name is: " << name << endl;
        cout << "Age is: " << age << endl;
        cout << "Roll. no is: " << rollno << endl;
    }
};

int main() {
    Student s1;
    s1.display();
    return 0;
}
