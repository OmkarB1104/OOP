#include <iostream>
using namespace std;

class Student {
private:
    char name[10];
    int roll;

public:
    void accept() {
        cout << "Name: ";
        cin >> name;
        cout << "Roll no.: ";
        cin >> roll;
    }

    void disp() {
        cout << roll;
        cout << ", " << name;
    }
};

int main() {
    Student S1;
    S1.accept();
    S1.disp();
    return 0;
}
