#include <iostream>
#include <fstream>
#include <string>
using namespace std;

int main() {
    string word;
    int count = 0;
    ifstream fin("source.txt");
    ofstream fout("destination.txt");
    
    if (!fin) {
        cout << "Error in opening source file." << endl;
        return 1;
    }
    if (!fout) {
        cout << "Error in opening destination file." << endl;
        fin.close();
        return 1;
    }
    
    while (fin >> word) {
        count++;
        fout << word;
    }
    fin.close();
    fout.close();
    cout << "Total No. of words: " << count << endl;
    return 0;
}
