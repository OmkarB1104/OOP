#include <iostream>
#include <fstream>
#include <string>
#include <cctype>
using namespace std;

int main() {
    char ch;
    int digitcount = 0, spacecount = 0;
    ifstream fin("source.txt");
    ofstream fout("destination.txt");
    
    if (!fin) {
        cout << "Error in opening source file" << endl;
        fin.close();
        return 1;
    }
    
    while (fin.get(ch)) {
        fout << ch;
        if (isdigit(ch))
            digitcount++;
        if (isspace(ch))
            spacecount++;
    }
    fin.close();
    fout.close();
    cout << "File is successfully copied." << endl;
    cout << "Number of digits: " << digitcount << endl;
    cout << "Number of spaces: " << spacecount << endl;
    return 0;
}
