#include <iostream>
#include <fstream>
#include <string>
using namespace std;

int main() {
    string word, a;
    int count = 0, acount = 0;
    ifstream fin("source.txt");
    ofstream fout("destination.txt");
    
    cout << "Enter a word: ";
    cin >> a;
    
    if (!fin) {
        cout << "Error in opening source file" << endl;
        return 1;
    }
    if (!fout) {
        cout << "Error in opening destination file" << endl;
        fin.close();
        return 1;
    }
    
    while (fin >> word) {
        fout << word;
        if (word == a)
            acount++;
    }
    fin.close();
    fout.close();
    cout << "Total no. of repeats: " << acount << endl;
    return 0;
}
