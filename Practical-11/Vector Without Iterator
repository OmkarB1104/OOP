#include <iostream>
#include <vector>
#include <cctype>
using namespace std;

int main() {
    vector<char> v;
    unsigned int i;
    
    cout << "Initial size: " << v.size() << endl;
    
    for (int i = 0; i < 5; i++)
        v.push_back('a' + i);
    
    cout << "Original contents: ";
    for (int i = 0; i < v.size(); i++)
        cout << v[i] << " ";
    cout << endl;
    
    cout << "Expand vectors:" << endl;
    for (int i = 0; i < v.size(); i++)
        v.push_back('f' + i);
    
    cout << "Size now: " << v.size() << endl;
    cout << "Current contents: ";
    for (int i = 0; i < v.size(); i++)
        cout << v[i] << " ";
    cout << endl;
    
    for (int i = 0; i < v.size(); i++)
        v[i] = toupper(v[i]);
    
    cout << "Modified contents to uppercase:" << endl;
    for (int i = 0; i < v.size(); i++)
        cout << v[i] << " ";
    cout << endl;
    
    return 0;
}
