#include <iostream>
#include <string>
using namespace std;

class MyString {
    string s;
public:
    MyString() {}
    MyString(const string& x) : s(x) {}
    void read() { cin >> s; }
    void print() const { cout << s << endl; }
    friend MyString operator+(const MyString& a, const MyString& b) {
        return MyString(a.s + b.s);
    }
};

int main() {
    MyString a, b, c;
    a.read();
    b.read();
    c = a + b;
    c.print();
    return 0;
}
