#include <iostream>
#include <cmath>
using namespace std;

template <class T>
class Calculator {
private:
    T num1, num2;
public:
    Calculator(T n1, T n2) {
        num1 = n1;
        num2 = n2;
    }
    T add() {
        return num1 + num2;
    }
    T subtract() {
        return num1 - num2;
    }
    T multiply() {
        return num1 * num2;
    }
    T divide() {
        return num1 / num2;
    }
};

int main() {
    double a, b;
    int ch;
    
    cout << "Enter two numbers: ";
    cin >> a >> b;
    
    Calculator<double> calc(a, b);
    cout << "Addition: " << calc.add() << endl;
    cout << "Subtraction: " << calc.subtract() << endl;
    cout << "Multiplication: " << calc.multiply() << endl;
    cout << "Division: " << calc.divide() << endl;
    return 0;
}
