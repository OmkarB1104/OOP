#include <iostream>
using namespace std;

template <class T>
T func(T a[], int n) {
    T sum = 0;
    int i;
    for (i = 0; i < n; i++)
        sum = sum + a[i];
    return sum;
}

int main() {
    int a1[3] = {1, 3, 2};
    float a2[3] = {1.2, 1.2, 2.4};
    double a3[3] = {10.5, 20.5, 30.5};
    
    cout << "Sum of integer array: " << func(a1, 3) << endl;
    cout << "Sum of float array: " << func(a2, 3) << endl;
    cout << "Sum of double array: " << func(a3, 3) << endl;
    return 0;
}
