#include <iostream>
using namespace std;

template <class T>
class Stack {
private:
    T ary[100];
    int top;
public:
    Stack() {
        top = -1;
    }
    void push(T val) {
        if (top >= 99)
            cout << "Stack Overflow !!" << endl;
        else {
            ary[++top] = val;
            cout << "Pushed " << val << endl;
        }
    }
    void pop() {
        if (top >= 0) {
            cout << "Popped " << ary[top--] << endl;
        } else
            cout << "Stack underflow" << endl;
    }
    void display() {
        cout << "Stack: ";
        for (int i = 0; i <= top; i++)
            cout << ary[i] << " ";
        cout << endl;
    }
};

int main() {
    Stack<int> s;
    s.push(10);
    s.push(20);
    s.push(30);
    s.display();
    s.pop();
    s.pop();
    s.pop();
    s.pop();
    return 0;
}
