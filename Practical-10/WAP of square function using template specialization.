#include <iostream>
#include <string>
using namespace std;

template <class T>
T square(T e) {
    T sum = 0;
    sum = e * e;
    return sum;
}

template <>
string square<string>(string s) {
    return s + s;
}

int main() {
    int i = 2;
    int ii = square(i);
    string w = "MIT";
    string ww = square(w);
    
    cout << "Square of 2 is: " << ii << endl;
    cout << "Square of given string is: " << ww << endl;
    return 0;
}
